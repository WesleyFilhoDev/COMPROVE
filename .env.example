# Copie para .env e preencha. O .env não vai para o Git.

# Neon: conexão com pooler (aplicação) e direta (migrações)
DATABASE_URL=
DIRECT_URL=

# Usuário Master criado pelo seed (senha com ao menos 12 caracteres)
MASTER_EMAIL=
MASTER_NAME=
MASTER_PASSWORD=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=
